# -------------------- MCP gateway --------------------
MCP_PUBLIC_HOST=mcp.example.com
MCP_HOST=0.0.0.0
MCP_PORT=8765

# bearer = require Authorization: Bearer <MCP_API_TOKEN>
# proxy  = trust an authenticated reverse proxy such as Cloudflare Access
# none   = local development only
MCP_AUTH_MODE=bearer
MCP_API_TOKEN=replace-with-a-long-random-secret

# Comma-separated integrations to enable.
MCP_INTEGRATIONS=trilium

# Log tool calls as JSON to stdout. No note content or secrets are logged.
MCP_AUDIT_LOG=true

# -------------------- Trilium --------------------
TRILIUM_ETAPI_URL=https://notes.example.com/etapi
TRILIUM_ETAPI_TOKEN=replace-with-dedicated-etapi-token

# Required for Trilium writes. Create an "AI Workspace" note and place its
# noteId here. Leave blank to disable Trilium writes entirely.
TRILIUM_WRITE_ROOT_NOTE_ID=replace-with-ai-workspace-note-id
