# -------------------- MCP gateway --------------------
MCP_PUBLIC_HOST=mcp.example.com
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Recommended: identify each client with its own static bearer token.
MCP_AUTH_MODE=multi_bearer
MCP_CLIENTS_FILE=/config/clients.json

# Legacy single-token mode only. Not used when MCP_AUTH_MODE=multi_bearer.
# MCP_API_TOKEN=

# Comma-separated integrations to enable.
MCP_INTEGRATIONS=trilium

# Log tool calls as JSON to stdout. Events include the authenticated client
# name, but never tokens, Authorization headers, or note contents.
MCP_AUDIT_LOG=true

# -------------------- Trilium --------------------
TRILIUM_ETAPI_URL=https://notes.example.com/etapi
TRILIUM_ETAPI_TOKEN=replace-with-dedicated-etapi-token

# Optional global hard ceiling for ALL Trilium writes from every client.
# If configured, a per-client write root must also be inside this subtree.
# Leave blank if per-client ACLs alone should define the write boundary.
TRILIUM_WRITE_ROOT_NOTE_ID=
